#!/usr/bin/env bash
# Usage: https://taskfile.build/usage/
set -e

if [[ -f ".env" ]]; then
    # shellcheck source=/dev/null
    source ".env"
fi

help-table() {
    local -a rows
    local max_cmd=7 max_opt=6 max_desc=11

    rows+=("Command|Option|Description")
    rows+=("===Hugo===| | ")
    rows+=("install-hugo||Install Hugo from binary source.")
    rows+=("dev-hugo-site|[url]|Start Hugo dev server.")
    rows+=("build-hugo-site|[url]|Build with Hugo.")
    rows+=("serve-hugo-site||Serve output from public folder.")
    rows+=("===Project===| | ")
    rows+=("prepare-hugo-site||Build assets with pnpm.")
    rows+=("new-post|[title]|Create new post from Hugo template.")

    for row in "${rows[@]}"; do
        IFS='|' read -r cmd opt desc <<< "$row"
        (( ${#cmd} > max_cmd )) && max_cmd=${#cmd}
        (( ${#opt} > max_opt )) && max_opt=${#opt}
        (( ${#desc} > max_desc )) && max_desc=${#desc}
    done

    printf '| %-*s | %-*s | %-*s |\n' \
        "$max_cmd" "Command" \
        "$max_opt" "Option" \
        "$max_desc" "Description"

    printf '|-%*s-|-%*s-|-%*s-|\n' \
        "$max_cmd" "$(printf '%*s' "$max_cmd" '' | tr ' ' '-')" \
        "$max_opt" "$(printf '%*s' "$max_opt" '' | tr ' ' '-')" \
        "$max_desc" "$(printf '%*s' "$max_desc" '' | tr ' ' '-')"

    local first_row=true
    for row in "${rows[@]:1}"; do
        IFS='|' read -r cmd opt desc <<< "$row"
        if [[ "$cmd" =~ ^===.*===$ ]]; then
            group_name="${cmd/===/}"
            group_name="${group_name/===/}"

            if [ "$first_row" = true ]; then
                first_row=false
            else
                printf '|-%*s-|-%*s-|-%*s-|\n' \
                    "$max_cmd" "$(printf '%*s' "$max_cmd" '' | tr ' ' '-')" \
                    "$max_opt" "$(printf '%*s' "$max_opt" '' | tr ' ' '-')" \
                    "$max_desc" "$(printf '%*s' "$max_desc" '' | tr ' ' '-')"
            fi

            local left_pad=$(( (max_cmd - ${#group_name}) / 2 ))
            local right_pad=$(( max_cmd - left_pad - ${#group_name} ))
            printf '| %*s%s%*s | %*s | %*s |\n' \
                "$left_pad" "" \
                "$group_name" \
                "$right_pad" "" \
                "$max_opt" "" \
                "$max_desc" ""

            printf '|-%*s-|-%*s-|-%*s-|\n' \
                "$max_cmd" "$(printf '%*s' "$max_cmd" '' | tr ' ' '-')" \
                "$max_opt" "$(printf '%*s' "$max_opt" '' | tr ' ' '-')" \
                "$max_desc" "$(printf '%*s' "$max_desc" '' | tr ' ' '-')"
        else
            first_row=false
            printf '| %-*s | %-*s | %-*s |\n' \
                "$max_cmd" "$cmd" \
                "$max_opt" "$opt" \
                "$max_desc" "$desc"
        fi
    done
}

help() {
    local grep_pattern
    echo
    if [[ -n "$1" ]]; then
        grep_pattern="$1"
        help-table | grep -i "$grep_pattern" | column -t -s'|'
    else
        echo "task <command> [options]"
        echo
        echo "commands:"
        echo
        help-table
    fi
    echo
}

BASE_URL="http://localhost:1313"

# Import commands

if [[ -d "$HOME/taskfile.build/bin" ]]; then
    for file in "$HOME/taskfile.build/bin/"*; do
        if [[ -f "$file" ]]; then
            source "$file"
        fi
    done
fi

# Project commands

prepare-hugo-site() {
    pnpm run build
}

new-post() {
    if [[ -z "$1" ]]; then
        echo "Error: Title is required. Usage: task new-post \"Post Title\""
        return 1
    fi
    
    # Format title (replace spaces with dashes)
    local formatted_title=$(echo "$1" | sed 's/ /-/g' | tr '[:upper:]' '[:lower:]')

    # Prefix filename with date and pin slug so the URL stays /blog/<slug>/
    local datestamp=$(date +%Y-%m-%d)
    local filename="$datestamp-$formatted_title.md"

    # Create post using hugo
    ./hugo new "blog/posts/$filename"

    local post="content/de/blog/posts/$filename"

    # Add slug and fix title (archetype derives it from the date-prefixed filename)
    local title=$(echo "$1" | sed 's/-/ /g')
    sed -i "/^date:/a slug: $formatted_title" "$post"
    sed -i "s|^title:.*|title: $title|" "$post"

    echo "Created new post: content/de/blog/posts/$filename"
}

if [[ "$1" == *","* ]]; then
    # Split comma-separated commands
    IFS=',' read -ra COMMANDS <<< "$1"
    for cmd in "${COMMANDS[@]}"; do
        # Trim whitespace
        cmd=$(echo "$cmd" | xargs)
        if declare -f "$cmd" > /dev/null; then
            "$cmd"
        else
            echo "Unknown command: $cmd"
            help "$@"
            exit 1
        fi
    done
elif declare -f "$1" > /dev/null; then
    if [[ "${2:-}" == "tfhelp" ]]; then
        help "$1"
    else
        "$1" "${@:2}"
    fi
else
    case "$1" in
        *)
            echo "Unknown command: $1"
            exit 1
            ;;
    esac
fi
